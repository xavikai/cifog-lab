@@ -0,0 +1,712 @@
+:root{
+ color-scheme:dark;
+ --bg:#191b1e;--line:#3a4047;--text:#f3f4f6;--muted:#afb7c1;--yellow:#ffbf00;
+ /* Blender-like workspace palette */
+ --b-area:#303030;--b-header:#262626;--b-editor:#1d1d1d;--b-widget:#545454;--b-widget-hi:#656565;--b-field:#1d1d1d;
+ --b-border:#161616;--b-text:#e6e6e6;--b-dim:#a6a6a6;--b-blue:#4772b3;--b-blue-hi:#5680c2;
+ --edge:#101215;--sel:#ffa01c;--active:#ffffff;--cut:#ff3b30;
+ font-family:Inter,'Segoe UI',Arial,sans-serif
+}
+*{box-sizing:border-box}
+body{margin:0;background:var(--bg);color:var(--text)}
+button,input,select{font:inherit}
+button{cursor:pointer}
+button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:2px solid var(--yellow);outline-offset:2px}
+a{color:inherit;text-decoration:none}
+h1,h2,p{margin:0}
+[hidden]{display:none!important}
+.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
+kbd{font:inherit;font-size:.92em;display:inline-block;min-width:1.5em;text-align:center;background:#1a1c20;border:1px solid #6d737b;border-bottom-width:2px;border-radius:4px;padding:0 4px;color:#fff;font-weight:650;line-height:1.35}
+kbd+kbd{margin-left:2px}
+
+/* Site header */
+.site-header{height:64px;display:flex;align-items:center;gap:20px;padding:0 clamp(16px,3vw,40px);border-bottom:1px solid var(--line)}
+.brand{color:var(--yellow);min-width:74px}
+.brand-mark{font-size:1.75rem;line-height:1;font-weight:850;letter-spacing:-2px}
+.brand-mark span{font-weight:650;font-size:.6rem;letter-spacing:2px;display:block;margin-top:5px;text-align:right}
+.header-rule{height:32px;width:1px;background:#50545c}
+.header-title{display:flex;flex-direction:column;gap:3px}
+.header-title strong{font-size:1rem}
+.header-label,.eyebrow,.control-label{font-size:.63rem;letter-spacing:1.6px;font-weight:750}
+.header-label{color:#b0b8c2}
+.home-link{margin-left:auto;color:#cbd2db;font-size:.8rem}
+.home-link:hover,footer a:hover{color:var(--yellow)}
+main{max-width:1680px;margin:auto}
+
+/* Top of the lab */
+.lab-top{display:flex;align-items:end;justify-content:space-between;gap:24px;flex-wrap:wrap;padding:18px clamp(16px,3vw,40px) 12px}
+.lab-lead h1{font-size:clamp(1.6rem,2.6vw,2.2rem);letter-spacing:-.045em;line-height:1.05;font-weight:700}
+.lab-lead h1 span{color:var(--yellow)}
+.lab-lead p{color:#bec6cf;font-size:.9rem;line-height:1.55;margin-top:8px;max-width:70ch}
+.lab-lead strong{color:#fff}
+.model-switch{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
+.model-switch .control-label{color:#aeb7c3;margin-right:6px}
+.model-button{background:#292e35;color:#e9eef4;border:1px solid #56606b;border-radius:6px;padding:7px 13px;min-width:112px;text-align:left;font-size:.82rem;font-weight:700}
+.model-button small{display:block;color:#aab5c1;font-size:.64rem;font-weight:400;margin-top:2px}
+.model-button.active{border-color:var(--yellow);background:#ffbf0014}
+
+/* Step guide */
+.guide{list-style:none;margin:0 clamp(16px,3vw,40px) 10px;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}
+.guide li{display:flex;gap:10px;align-items:center;padding:6px 11px;border:1px solid #3b4148;border-radius:7px;background:#20242a;color:#9aa4af;transition:border-color .2s,background .2s}
+.guide li b{flex:none;width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font-size:.72rem;background:#353b43;color:#cfd6de}
+.guide li strong{display:block;font-size:.8rem;color:#d6dce3}
+.guide li small{display:block;font-size:.68rem;margin-top:2px;line-height:1.35}
+.guide li.done b{background:#3d6b4c;color:#dff5e5}
+.guide li.current{border-color:var(--yellow);background:#ffbf0012;color:#e5e9ee}
+.guide li.current b{background:var(--yellow);color:#17191b}
+.guide li.current strong{color:#fff}
+.guide li.nudge{animation:nudge .5s ease 2}
+@keyframes nudge{50%{transform:translateY(-3px);box-shadow:0 4px 0 #ffbf0044}}
+
+/* Blender-style workspace */
+.blender{position:relative;margin:0 clamp(16px,3vw,40px);background:var(--b-border);border:1px solid #0e0e0e;border-radius:9px;overflow:hidden;box-shadow:0 16px 40px #0007;color:var(--b-text);font-size:13px}
+.topbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:6px 8px;background:var(--b-header);border-bottom:1px solid var(--b-border)}
+.topbar-context{display:inline-flex;align-items:center;height:24px;padding:0 8px;border:1px solid #59606a;border-radius:4px;background:#1c1c1c;color:#d9dee5;font-size:10px;font-weight:800;letter-spacing:1px;white-space:nowrap}
+.mode-select select,.menu-button,.icon-toggle,.op,.mini-button,.stretch-toggle button,.tool{border:1px solid #1b1b1b;color:var(--b-text);border-radius:4px;font-size:12.5px}
+.mode-select select{background:var(--b-widget);padding:5px 8px;height:30px;cursor:pointer}
+.select-modes{display:flex}
+.icon-toggle{display:flex;align-items:center;gap:5px;background:var(--b-widget);padding:0 9px;height:30px;border-radius:0}
+.icon-toggle:first-child{border-radius:4px 0 0 4px}.icon-toggle:last-child{border-radius:0 4px 4px 0;border-left:0}
+.icon-toggle svg{width:16px;height:16px}
+.icon-toggle kbd{font-size:10px;background:transparent;border-color:#ffffff55;padding:0 3px}
+.icon-toggle[aria-pressed="true"]{background:var(--b-blue);color:#fff}
+.icon-toggle:hover:not([aria-pressed="true"]),.op:hover:not(:disabled),.mini-button:hover,.menu-button:hover,.stretch-toggle button:hover:not([aria-pressed="true"]),.mode-select select:hover{background:var(--b-widget-hi)}
+.menubar{display:flex;gap:2px}
+.menu-button{background:transparent;border-color:transparent;padding:5px 10px;height:30px}
+.menu-button[aria-expanded="true"]{background:var(--b-blue);color:#fff}
+.bar-sep{width:1px;height:22px;background:#444}
+.quick-ops{display:flex;gap:5px;flex-wrap:wrap}
+.op{background:var(--b-widget);padding:0 11px;height:30px;display:flex;align-items:center;gap:7px;font-weight:600}
+.op i{width:14px;height:3px;border-radius:2px;display:inline-block}
+.op-mark i{background:var(--cut)}.op-clear i{background:#8d949c}
+.op:disabled{opacity:.4;cursor:not-allowed}
+.op-unwrap.needed{background:var(--yellow);color:#17191b;border-color:#9a7400;box-shadow:0 0 0 3px #ffbf0040}
+.op-unwrap.needed:hover{background:#ffd255}
+.live-toggle{margin-left:auto;display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--b-dim);cursor:pointer;user-select:none}
+.live-toggle input{position:absolute;opacity:0;width:1px;height:1px}
+.switch{width:30px;height:17px;border-radius:10px;background:#555;position:relative;transition:background .15s}
+.switch:after{content:"";position:absolute;top:2px;left:2px;width:13px;height:13px;border-radius:50%;background:#ddd;transition:transform .15s}
+.live-toggle input:checked+.switch{background:var(--b-blue)}
+.live-toggle input:checked+.switch:after{transform:translateX(13px)}
+.live-toggle input:focus-visible+.switch{outline:2px solid var(--yellow);outline-offset:2px}
+.live-toggle:has(input:checked){color:var(--b-text)}
+
+.editors{display:grid;grid-template-columns:1fr 1fr;gap:2px;background:var(--b-border)}
+.editor{min-width:0;display:flex;flex-direction:column;background:var(--b-area)}
+.editor-header{display:flex;align-items:center;gap:10px;min-height:36px;padding:3px 8px;background:var(--b-area);border-bottom:1px solid var(--b-border);flex-wrap:wrap}
+.editor-type{display:flex;align-items:center;gap:6px;font-weight:650;color:#fff;padding-right:4px}
+.editor-type svg{width:15px;height:15px;color:#9fb6d6}
+.editor-role{font-size:9.5px;letter-spacing:1.1px;color:#8f9aa7;font-weight:750;border-left:1px solid #4a4a4a;padding-left:9px}
+.viewport{order:-1}
+#object-title{font-weight:500;color:var(--b-dim);font-size:12.5px}
+.selection-state{font-size:9.5px;letter-spacing:.8px;text-transform:uppercase;font-weight:750;color:#ffc266;border:1px solid #9a681f;background:#ff9d1a18;border-radius:3px;padding:2px 6px}
+.selection-state.off{color:#9da4ad;border-color:#555;background:transparent}
+.viewer-legend{margin-left:auto;display:flex;gap:12px;font-size:11.5px;color:var(--b-dim)}
+.viewer-legend span{display:flex;align-items:center;gap:5px}
+.viewer-legend i{display:inline-block;width:14px;height:4px;border-radius:2px}
+.legend-edge{background:#0b0c0e;box-shadow:0 0 0 1px #777}.legend-sel{background:var(--sel)}.legend-cut{background:var(--cut)}
+.stretch-toggle{margin-left:auto;display:flex;align-items:center}
+.stretch-toggle span{font-size:11.5px;color:var(--b-dim);margin-right:7px}
+.stretch-toggle button{background:var(--b-widget);padding:3px 8px;border-radius:0;height:26px}
+.stretch-toggle button:nth-of-type(1){border-radius:4px 0 0 4px}.stretch-toggle button:last-child{border-radius:0 4px 4px 0}
+.stretch-toggle button+button{border-left:0}
+.stretch-toggle button[aria-pressed="true"]{background:var(--b-blue);color:#fff}
+
+.canvas-host,.map-host{position:relative;height:clamp(340px,calc(100vh - 390px),620px);min-height:340px;overflow:hidden}
+.canvas-host{background:radial-gradient(circle at 50% 45%,#454a52,#2d3035 72%)}
+.canvas-host canvas{display:block;width:100%;height:100%;touch-action:none}
+.canvas-host.hovering-edge canvas{cursor:pointer}
+.map-host{background:#232323;display:grid;place-items:center}
+.map-host svg{width:100%;height:100%;max-width:640px}
+.canvas-hint{position:absolute;top:50%;left:0;right:0;text-align:center;color:#e6e8ec;font-size:.85rem;pointer-events:none}
+.nav-hint{position:absolute;right:10px;top:9px;font-size:11px;color:#c7ccd2;background:#1f2124cc;padding:4px 8px;border-radius:4px;pointer-events:none;max-width:calc(100% - 80px);text-align:right}
+.nav-hint kbd{font-size:10px}
+
+.toolshelf{position:absolute;left:8px;top:8px;display:flex;flex-direction:column;gap:3px;background:#262626e6;padding:4px;border-radius:6px;border:1px solid #111;z-index:2}
+.tool{display:flex;flex-direction:column;align-items:center;gap:2px;width:58px;padding:6px 2px 4px;background:transparent;border-color:transparent;font-size:10px;color:#cfcfcf}
+.tool svg{width:20px;height:20px}
+.tool:hover{background:#3d3d3d}
+.tool.active{background:var(--b-blue);color:#fff}
+.tool[data-tool="seam"] svg{color:var(--cut)}
+.tool[data-tool="seam"].active svg{color:#fff}
+
+.fold-controls{position:absolute;left:50%;bottom:10px;transform:translateX(-50%);display:flex;align-items:center;gap:9px;background:#262626ee;border:1px solid #111;border-radius:6px;padding:6px 8px 6px 10px;font-size:12px;color:#d3d3d3;width:min(430px,calc(100% - 20px))}
+.fold-tag{font-size:9.5px;letter-spacing:1.3px;font-weight:750;color:var(--yellow)}
+.fold-controls input{flex:1;min-width:60px;accent-color:var(--yellow);direction:rtl}
+.fold-button{background:var(--yellow);color:#17191b;border:0;border-radius:4px;padding:6px 10px;font-weight:700;font-size:12px;white-space:nowrap}
+.fold-button:hover{background:#ffd255}
+.fold-button:disabled,.fold-controls input:disabled{opacity:.45;cursor:not-allowed}
+
+/* UV map */
+.axis{fill:#98a2ad;font-size:12px;font-family:inherit;font-weight:650}
+.axis-name{fill:#d9dee4;font-size:14px;font-weight:800}
+.uv-face{cursor:pointer;outline:none}
+.uv-face polygon{stroke:none}
+.uv-face.hovered polygon{filter:brightness(1.15)}
+.uv-face.selected polygon{filter:brightness(1.08) sepia(.35)}
+.uv-face .sel-tint{fill:#ff9a1a;fill-opacity:.32;pointer-events:none}
+.uv-face .trace{fill:none;stroke:var(--yellow);stroke-width:4;stroke-dasharray:7 5;pointer-events:none}
+.uv-face:focus-visible .trace{stroke:#fff}
+.uv-face text{font-family:inherit;pointer-events:none;text-anchor:middle;dominant-baseline:middle;fill:#20242b}
+.uv-face .face-name{font-weight:700}
+.uv-face .face-letter{font-weight:850}
+.uv-checker{fill:url(#uv-check);pointer-events:none}
+.uv-edge .edge-line{stroke:var(--edge);stroke-width:1.6;stroke-linecap:round;pointer-events:none}
+.uv-edge.seam .edge-line{stroke:var(--cut);stroke-width:4}
+.uv-edge.selected .edge-line{stroke:var(--sel);stroke-width:4.5}
+.uv-edge.active .edge-line{stroke:var(--active);stroke-width:5}
+.uv-edge.hovered .edge-line{stroke-width:6;filter:drop-shadow(0 0 3px #fff)}
+.uv-edge.hovered:not(.seam):not(.selected) .edge-line{stroke:#fff}
+.uv-edge .edge-hit{stroke:transparent;stroke-width:13;stroke-linecap:round;cursor:pointer}
+.face-mode .uv-edge .edge-hit,.object-mode .uv-edge .edge-hit{pointer-events:none}
+.island-label{fill:#d2dce7;font-size:9.5px;font-weight:750;letter-spacing:.5px;pointer-events:none}
+.map-overlay{position:absolute;inset:0;display:grid;place-content:center;justify-items:center;gap:12px;text-align:center;padding:32px;background:#1d1d1de0;color:#eef1f4;font-size:.9rem;line-height:1.55}
+.map-overlay strong{font-size:1rem;color:#fff}
+.map-overlay.warning strong{color:#ff8a80}
+.map-overlay button{background:var(--b-widget);color:#fff;border:1px solid #111;border-radius:4px;padding:6px 12px}
+.map-overlay button:hover{background:var(--b-widget-hi)}
+.map-stale{position:absolute;bottom:10px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:10px;background:#3b3220f2;border:1px solid #a8801f;border-radius:6px;padding:6px 7px 6px 12px;font-size:12px;color:#ffe3a3;white-space:nowrap;box-shadow:0 6px 18px #0008}
+.map-stale button{background:var(--yellow);color:#17191b;border:0;border-radius:4px;padding:5px 9px;font-weight:700;font-size:12px}
+.map-stale kbd{background:#0002;border-color:#0006;color:#17191b;font-size:10px}
+.map-host.is-stale svg #uv-faces,.map-host.is-stale svg #uv-edges{opacity:.55}
+
+.editor-footer{display:flex;align-items:center;gap:12px;min-height:38px;padding:4px 10px;border-top:1px solid var(--b-border);background:var(--b-area);font-size:12px;color:var(--b-dim);flex-wrap:wrap}
+.island-count{color:#fff;font-weight:650;margin-right:auto}
+.island-scale{display:flex;align-items:center;gap:6px}
+.island-scale kbd{font-size:10px}
+.island-scale input{width:110px;accent-color:var(--b-blue-hi)}
+.island-scale output{color:#fff;min-width:3.4em}
+.mini-button{background:var(--b-widget);padding:3px 9px;height:25px}
+
+.statusbar{display:flex;align-items:center;gap:18px;min-height:30px;padding:5px 10px;background:var(--b-header);border-top:1px solid var(--b-border);font-size:12px;color:var(--b-dim);flex-wrap:wrap}
